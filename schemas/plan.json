{
  "$defs": {
    "Backend": {
      "enum": [
        "nixpkgs",
        "flake",
        "external-flake"
      ],
      "type": "string"
    },
    "Identity": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "string"
        },
        "id": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "repository": {
          "type": "string"
        },
        "tree": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "repository",
        "commit",
        "tree"
      ],
      "type": "object"
    },
    "Mode": {
      "enum": [
        "head",
        "merge"
      ],
      "type": "string"
    },
    "Publication": {
      "enum": [
        "none",
        "request-approval"
      ],
      "type": "string"
    },
    "PullRequest": {
      "additionalProperties": false,
      "properties": {
        "base": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "head_repository": {
          "type": "string"
        },
        "merge": {
          "type": [
            "string",
            "null"
          ]
        },
        "number": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "parents": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "number",
        "url",
        "head_repository",
        "head",
        "base",
        "parents"
      ],
      "type": "object"
    },
    "Recipe": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "string"
        },
        "directory": {
          "default": ".",
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "source_input": {
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit",
        "source_input"
      ],
      "type": "object"
    },
    "Request": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "$ref": "#/$defs/Backend"
        },
        "cache_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "checks": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "directory": {
          "default": ".",
          "type": "string"
        },
        "expected_base": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_head": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "$ref": "#/$defs/Mode",
          "default": "head"
        },
        "packages": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "post_result": {
          "default": false,
          "type": "boolean"
        },
        "pr": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "publication": {
          "$ref": "#/$defs/Publication",
          "default": "none"
        },
        "recipe": {
          "anyOf": [
            {
              "$ref": "#/$defs/Recipe"
            },
            {
              "type": "null"
            }
          ]
        },
        "repository": {
          "type": "string"
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "runner_profile": {
          "default": "hosted-v1",
          "type": "string"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "systems": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "test_profile": {
          "default": "checks-v1",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "repository",
        "backend",
        "systems"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "controller": {
      "$ref": "#/$defs/Identity"
    },
    "digest": {
      "type": "string"
    },
    "pr": {
      "anyOf": [
        {
          "$ref": "#/$defs/PullRequest"
        },
        {
          "type": "null"
        }
      ]
    },
    "recipe": {
      "anyOf": [
        {
          "$ref": "#/$defs/Identity"
        },
        {
          "type": "null"
        }
      ]
    },
    "request": {
      "$ref": "#/$defs/Request"
    },
    "request_id": {
      "type": "string"
    },
    "run_attempt": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "run_id": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "run_repository": {
      "type": "string"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "target": {
      "$ref": "#/$defs/Identity"
    },
    "tool_lock": true,
    "tool_lock_digest": {
      "type": "string"
    },
    "workflow": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "request",
    "target",
    "controller",
    "workflow",
    "tool_lock",
    "tool_lock_digest",
    "run_repository",
    "run_id",
    "run_attempt",
    "digest"
  ],
  "title": "Plan",
  "type": "object"
}
